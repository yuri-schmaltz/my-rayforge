# Pre-install script
pre_install() {
  # Check that the runtime dependencies are present
  for dep in gtk4 libadwaita python-gobject; do
    if ! pacman -Q "$dep" >/dev/null 2>&1; then
      echo ":: Dependency missing: $dep"
      echo ":: Install it with: sudo pacman -S $dep"
      exit 1
    fi
  done
}

# Pre-upgrade script
pre_upgrade() {
  pre_install
}

# Pre-remove script
pre_remove() {
  # Remove any cached pixi environments
  rm -rf ~/.cache/pixi/environments/rayforge* 2>/dev/null || true
}

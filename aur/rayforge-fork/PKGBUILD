# Maintainer: Yuri Schmaltz <security at yuri-schmaltz dot dev>
# This is a TEMPLATE. To submit to the AUR:
#   1. Update pkgver and pkgrel for each release
#   2. Update the source URL and sha256 sums
#   3. Run updpkgsums to refresh the checksums
#   4. Run makepkg --printsrcinfo > .SRCINFO
#   5. Commit and push to the AUR git repo
pkgname=rayforge-fork
_pkgname=rayforge
pkgver=1.9.0+resilience.5
pkgrel=1
pkgdesc="Laser cutter/engraver controller (community fork with resilience patches)"
arch=('x86_64' 'aarch64')
url="https://github.com/yuri-schmaltz/rayforge"
license=('MIT')
depends=(
  'gtk4'
  'libadwaita'
  'python>=3.12'
  'python-gobject'
  'python-cairo'
  'librsvg'
  'poppler-glib'
  'libusb'
  'cython'
)
makedepends=(
  'git'
  'pixi'
  'python-build'
  'python-installer'
  'python-wheel'
)
optdepends=(
  'python-pyserial: serial port support for laser cutters'
  'python-netifaces: network interface detection'
)
provides=('rayforge')
conflicts=('rayforge')
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/yuri-schmaltz/${_pkgname}/archive/refs/tags/${pkgver}.tar.gz"
)
sha256sums=('REPLACE_WITH_SHA256')

build() {
  cd "${_pkgname}-${pkgver}"
  pixi install --frozen
  pixi run -e build python -m build --wheel
  pixi run -e build compile-translations
}

package() {
  cd "${_pkgname}-${pkgver}"
  # Install the wheel
  PIXI_PYTHON=$(pixi run -e build python -c "import sys; print(sys.executable)")
  $PIXI_PYTHON -m installer --destdir="$pkgdir" dist/rayforge*.whl
  # Install the .desktop file
  install -Dm644 resources/rayforge.desktop \
    "$pkgdir/usr/share/applications/rayforge.desktop"
  # Install the icon
  install -Dm644 resources/icons/rayforge.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/rayforge.svg"
  # Install license
  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # Install the locale files
  pixi run -e build compile-translations
  for locale_file in locale/*/LC_MESSAGES/*.mo; do
    if [ -f "$locale_file" ]; then
      install -Dm644 "$locale_file" \
        "$pkgdir/usr/share/locale/$(basename $(dirname $(dirname $locale_file)))/LC_MESSAGES/$(basename $locale_file)"
    fi
  done
}

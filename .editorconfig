# EditorConfig is awesome: https://EditorConfig.org
# Top-level config for the Pires Forge project. Per-language overrides
# match the existing tool configurations (ruff, prettier, etc.).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 79

[*.{md,yml,yaml,toml,json,sh}]
indent_size = 2

[*.{po,pot}]
indent_size = 4

[Makefile]
indent_style = tab

[*.{png,jpg,jpeg,gif,ico,icns,svg,webp}]
indent_style = space
indent_size = 2
